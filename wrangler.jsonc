{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "groundtruth-router",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat"],

  // Stateless MCP (createMcpHandler) — no Durable Objects binding required.
  // Everything durable lives in D1; the Worker holds no per-session state.
  "observability": { "enabled": true },

  // The workers.dev subdomain is per-ACCOUNT, so publishing on it would place
  // this Worker next to every other Worker on the account — a direct
  // account-level link, stronger than the nameserver pair we accepted.
  // Custom domain only. See docs/decisions.md.
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    // Verify's canonical home (rebrand 2026-08-17). The apex stays a route
    // for back-compat (existing MCP configs pin veritap.dev/mcp) and becomes
    // the brand hub; verify.veritap.dev is the new front door.
    { "pattern": "verify.veritap.dev", "custom_domain": true },
    { "pattern": "veritap.dev", "custom_domain": true },
    { "pattern": "www.veritap.dev/*", "zone_name": "veritap.dev" }
  ],

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "groundtruth",
      "database_id": "014b374c-d28a-4989-8ad3-4ab6ff108340",
      "migrations_dir": "migrations"
    }
  ],

  // Static agent-legible surface (ticket 9): llms.txt, openapi.yaml,
  // .well-known/*, per-claim-type HTML. Assets are served first; anything
  // unmatched falls through to the Worker, which owns /mcp.
  "assets": {
    "directory": "public",
    "not_found_handling": "none",
    // Rebrand: the Worker owns the primary human pages (host-aware hub vs
    // landing + the new brand assets) so verify.veritap.dev and the apex can
    // differ; the SEO claim-pages, sitemap, css, llms.txt stay static.
    "run_worker_first": ["/", "/docs", "/privacy", "/terms", "/logo.png", "/favicon.ico", "/og.png"],
    // Serve /claims/business-exists directly rather than 307-ing to the
    // trailing-slash form — the canonical tags and sitemap use the bare path,
    // and an extra hop weakens the discovery signal these pages exist for.
    "html_handling": "drop-trailing-slash"
  },

  // Nightly retention sweep: nulls raw_input_json older than 90 days (§7).
  // 04:17 nightly = sweeps + retention. Hourly = free-plan usage check,
  // hourly because the request cap resets at midnight UTC and a daily check
  // would report a breach long after traffic was already being dropped.
  "triggers": { "crons": ["17 4 * * *", "0 * * * *"] },

  // A15 layer 3: breaker alert. send_email can only ever deliver to an address
  // already VERIFIED as an Email Routing destination on this account, so it
  // cannot be abused as a relay no matter what reaches it. No address is named
  // here on purpose — the recipient comes from the ALERT_EMAIL secret, which
  // keeps a personal address out of a public repository.
  "send_email": [{ "name": "SEND_EMAIL" }],

  // SECRETS (set with `wrangler secret put`, never committed):
  //   ALERT_EMAIL  operator address for breaker + usage alerts
  //   NTFY_TOPIC   daily digest topic. ntfy topics are unauthenticated, so the
  //                string is a capability: anyone holding it can read the
  //                digest AND publish alerts to the phone. Treat as a secret.
  "vars": {
    // A1 desk verifier is live for BUSINESS_EXISTS_AND_OPERATING (free while
    // verification is new). The router additionally gates per-type on
    // canAutoVerify(), so this flag cannot advertise coverage the verifier
    // does not have (§10).
    "AUTO_VERIFIER_ENABLED": "true",

    // No REFERRAL_* vars: A8 removed outbound referrals entirely. A miss keeps
    // its signal in-house and is answered with alternatives + self-help + a
    // real report-back promise (see src/notify.ts).
    "PUBLIC_BASE_URL": "https://veritap.dev"
  }
}
